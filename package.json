{
  "name": "yunbianqian",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "云便签 — 极轻占用、高颜值、免登录的端到端零知识加密在线云便签与加密文件中转站（支持 Cloudflare Workers 一键部署 & 零依赖 Node.js 自托管）",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,green \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "build:node": "vite build && node scripts/compress.js",
    "start": "node --max-old-space-size=64 server/index.js",
    "start:win": "node --max-old-space-size=64 server/index.js",
    "preview": "vite preview",
    "test:crypto": "node --test server/test-crypto.js"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "lucide-react": "^0.475.0",
    "marked": "^15.0.7",
    "preact": "^10.26.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
